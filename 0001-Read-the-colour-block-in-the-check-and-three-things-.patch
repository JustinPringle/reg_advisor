+def _colours_by_sn(colours: list[dict[str, Any]]) -> dict[str, list[dict[str, Any]]]:
+    """Colour rows grouped per student, oldest period first."""
+    out: dict[str, list[dict[str, Any]]] = {}
+    for c in colours:
+        out.setdefault(str(c["student_number"]), []).append(
